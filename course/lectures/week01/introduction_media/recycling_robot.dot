// Recycling robot (Sutton & Barto, Example 3.3), redrawn with numbers instead of symbols.
// alpha = 0.8 (search at high stays high), beta = 0.7 (search at low stays low);
// rewards are the deck's illustrative values: search +2, wait 0, recharge 0, rescue -3.
// (wait was +1 until 2026-10-07; with gamma = 0.5 that made waiting at low optimal)
// Edge label: "probability, reward". Grey lines: choosing an action; black arrows: outcomes.
// Layout is pinned (pos="x,y!" in inches), so render with neato:
//   neato -Tpng -Gdpi=200 recycling_robot.dot -o recycling_robot.png
//   neato -Tsvg recycling_robot.dot -o recycling_robot.svg
digraph recycling_robot {
  layout=neato; splines=curved; bgcolor="white"; pad=0.2;
  node [fontname="Calibri", fontsize=24];
  edge [fontname="Calibri", fontsize=20, arrowsize=0.9, penwidth=1.6];

  // States
  high [pos="0,0!",   shape=circle, width=1.15, fixedsize=true, style=filled, fillcolor="#FBE9E9", color="#C00000", penwidth=2.5];
  low  [pos="5.6,0!", shape=circle, width=1.15, fixedsize=true, style=filled, fillcolor="#F2F2F2", color="#595959", penwidth=2.5];

  // Actions: small dots; their names are separate pinned labels
  node [shape=point, width=0.16, color="#262626"];
  hw [pos="-1.2,2.0!"];  hs [pos="1.4,-2.1!"];
  lr [pos="2.8,0!"];
  ls [pos="4.2,2.1!"];   lw [pos="6.8,-2.0!"];
  node [shape=plaintext, fontsize=20, width=0, height=0, margin=0];
  hw_t [pos="-1.2,2.35!", label="wait"];
  hs_t [pos="1.4,-2.45!", label="search"];
  lr_t [pos="2.8,-0.3!",  label="recharge"];
  ls_t [pos="4.2,2.45!",  label="search"];
  lw_t [pos="6.8,-2.35!", label="wait"];

  // Choosing an action (grey, no arrowhead), leaving from one side of the state
  edge [arrowhead=none, color="#A6A6A6"];
  high:n -> hw; high:se -> hs;
  low:w -> lr; low:n -> ls; low:se -> lw;

  // Outcomes (black arrows); their "probability, reward" labels are pinned below
  edge [arrowhead=normal, color="#262626"];
  hw -> high:w; hs -> high:s; hs -> low:sw; lr -> high:e; ls -> low:ne; lw -> low:e;
  ls -> high:ne [color="#C00000"];

  node [shape=plaintext, fontsize=20, width=0, height=0, margin=0];
  o_hw [pos="-1.65,1.15!", label="1, 0"];
  o_hs [pos="-0.5,-1.4!",  label="0.8, +2"];
  o_hl [pos="3.3,-1.5!",   label="0.2, +2"];
  o_lr [pos="1.2,0.35!",   label="1, 0"];
  o_ls [pos="6.3,1.55!",   label="0.7, +2"];
  o_lh [pos="0.95,1.95!",  label="0.3, −3 (rescued)", fontcolor="#C00000"];
  o_lw [pos="7.1,-0.7!",   label="1, 0"];
}
